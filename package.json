{
  "name": "werewolf-ai",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "description": "AI 狼人杀 · Agent 补位局 —— 6 人局狼人杀（1 真人 + 5 LLM 智能体），全部 AI 言行由大模型实时生成",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "prestart": "node tools/ensure-build.mjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:live": "node tools/live-smoke.mjs",
    "screens": "node tools/screens.mjs",
    "design:export": "node tools/ardot-export.mjs",
    "repo:check": "node tools/repo-check.mjs"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "dev",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
