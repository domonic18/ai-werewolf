node_modules/
.DS_Store
*.log
.env
config/cloud.json

# 本地调试产物（截图、临时脚本、抓包结果）
# 不能依赖本机的全局 gitignore：换机器或别人克隆后这批文件会变成未跟踪文件
tmp/

# 构建产物（Vite 前端 + tsc 服务端）
dist/
dist-server/
coverage/
*.tsbuildinfo

# 项目文档需要入库（覆盖全局 *.md 忽略规则）
!README.md
!AGENTS.md
!CLAUDE.md
!docs/**/*.md
!specs/**/*.md
!.specify/**/*.md
!.claude/skills/**/*.md

# README 界面截图需要入库（覆盖全局 *.png 忽略规则）
!docs/screenshots/*.png

# Ardot 导入用的静态稿是生成物（npm run design:export 可重建）
docs/designs-v2/
